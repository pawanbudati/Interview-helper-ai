# Interview Helper AI - API Configuration
# Rename this file to .env or .env.local to configure your keys

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
VITE_GEMINI_API_KEY=

# Groq API Key (Optional, from https://console.groq.com/)
VITE_GROQ_API_KEY=

# OpenAI API Key (Optional, from https://platform.openai.com/)
VITE_OPENAI_API_KEY=
